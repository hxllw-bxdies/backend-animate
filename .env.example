# Configuración de ejemplo. Genera tu .env con:  python scripts/generar_env.py
# (el script reemplaza las claves por valores aleatorios). NO subas .env a GitHub.

# Contraseñas de las cuentas iniciales (solo se usan la primera vez que se crean)
ADMIN_PASSWORD=AdminAnimate#1
USUARIO_PASSWORD=Carlos#Laraña1

# Clave compartida entre Pedidos y Catálogo para /internal/ventas
INTERNAL_API_KEY=local-cambiar-clave-interna-32-caracteres

# Contraseñas de las 3 bases MySQL (Docker o MySQL local)
DB_USUARIOS_PASSWORD=usuarios-local-cambiar
DB_CATALOGO_PASSWORD=catalogo-local-cambiar
DB_PEDIDOS_PASSWORD=pedidos-local-cambiar

# Orígenes del frontend permitidos por CORS (separados por coma)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true solo cuando se use HTTPS (por ejemplo en la EC2 con certificado)
COOKIE_SECURE=false

# Solo para MySQL instalado localmente (scripts/iniciar_local.py --perfil mysql)
DB_USUARIOS_USER=animate_usuarios
DB_CATALOGO_USER=animate_catalogo
DB_PEDIDOS_USER=animate_pedidos
